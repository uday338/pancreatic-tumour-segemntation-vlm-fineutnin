#!/bin/bash
#PBS -N nnunet_train
#PBS -P ${PBS_PROJECT:-your_project_code}
#PBS -q standard
#PBS -l select=1:ncpus=4:ngpus=1:centos=icelake
#PBS -l walltime=24:00:00
#PBS -o logs/nnunet_train.out
#PBS -e logs/nnunet_train.err
# centos=icelake pins the job to A100 nodes; the older K40m GPUs are too old for PyTorch 2.6 + CUDA 11.8.
cd $PBS_O_WORKDIR
mkdir -p logs
source configs/paths.env
# module load / conda activate your environment here
# Submit one job per fold:  for f in 0 1 2 3 4; do qsub -v DATASET=1,FOLD=$f jobs/nnunet_train.pbs; done
: "${DATASET:?set DATASET}" "${FOLD:?set FOLD}"
nnUNetv2_train "$DATASET" 3d_fullres "$FOLD" --npz
