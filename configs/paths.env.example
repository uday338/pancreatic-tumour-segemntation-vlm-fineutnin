# Copy to configs/paths.env, edit, then: source configs/paths.env
export PROJECT=/scratch/$USER/pancreas
export MSD=$PROJECT/data/Task07_Pancreas          # imagesTr/ labelsTr/ from the Decathlon
export AMOS=$PROJECT/data/amos22                  # imagesTr/ labelsTr/ (imagesVa/ labelsVa/)
export nnUNet_raw=$PROJECT/nnUNet_raw
export nnUNet_preprocessed=$PROJECT/nnUNet_preprocessed
export nnUNet_results=$PROJECT/nnUNet_results
export HF_HOME=$PROJECT/hf_cache                  # Qwen weights cache
# dataset ids
export D_BASE=1 D_MASK=3 D_ROI=6 D_AMOS=10
